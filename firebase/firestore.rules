rules_version = '2';

/*
 * DLMSF Firestore security baseline.
 * Trusted Cloud Functions use the Admin SDK and must enforce authorization.
 */

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function instanceConfigExists() {
      return exists(/databases/$(database)/documents/system/config);
    }

    function isMaintainingAdmin() {
      return signedIn()
        && instanceConfigExists()
        && get(/databases/$(database)/documents/system/config)
          .data.maintainingAdminUid == request.auth.uid;
    }

    function isLinkedMember(memberId) {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(memberId))
        && get(/databases/$(database)/documents/members/$(memberId))
          .data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/members/$(memberId))
          .data.isActive == true;
    }

    function canReadMemberRecord() {
      return isMaintainingAdmin()
        || (
          resource.data.memberId is string
          && isLinkedMember(resource.data.memberId)
        );
    }

    match /system/config {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    // Admin may manage member details, but only trusted functions can link
    // an Authentication UID or change the role.
    match /members/{memberId} {
      allow get: if isMaintainingAdmin() || isLinkedMember(memberId);
      allow list: if isMaintainingAdmin();
      allow create: if isMaintainingAdmin()
        && request.resource.data.memberId == memberId
        && request.resource.data.role == "member"
        && request.resource.data.authUid == null;
      allow update: if isMaintainingAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["authUid", "role"]);
      allow delete: if isMaintainingAdmin()
        && resource.data.authUid == null;
    }

    // UID mappings are created/changed only by trusted Admin SDK code.
    match /memberAccounts/{authUid} {
      allow get: if isMaintainingAdmin()
        || (signedIn() && request.auth.uid == authUid);
      allow list, create, update, delete: if false;
    }

    // Invitation records are readable by the admin or their intended email.
    // All invitation mutations must go through trusted callable functions.
    match /invitations/{invitationId} {
      allow get: if isMaintainingAdmin()
        || (
          signedIn()
          && resource.data.email is string
          && request.auth.token.email is string
          && request.auth.token.email.lower() == resource.data.email
        );
      allow list: if isMaintainingAdmin();
      allow create, update, delete: if false;
    }

    match /fiscalYears/{fiscalYearId} {
      allow read: if isMaintainingAdmin();
      allow write: if false;
    }

    match /contributions/{recordId} {
      allow read: if canReadMemberRecord();
      allow write: if false;
    }

    match /loans/{loanId} {
      allow read: if canReadMemberRecord();
      allow write: if false;
    }

    match /loanPayments/{paymentId} {
      allow read: if canReadMemberRecord();
      allow write: if false;
    }

    match /loanRequests/{requestId} {
      allow read: if canReadMemberRecord();
      allow write: if false;
    }

    match /paymentSubmissions/{submissionId} {
      allow read: if canReadMemberRecord();
      allow write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isMaintainingAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
